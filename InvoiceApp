import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import javax.swing.table.TableRowSorter;
import java.awt.*;
import java.awt.event.KeyAdapter;
import java.awt.event.KeyEvent;
import java.io.File;
import java.text.ParseException;
import java.text.SimpleDateFormat;
import java.util.Calendar;
import java.util.Properties;
import javax.swing.JFormattedTextField.AbstractFormatter;
import org.jdatepicker.impl.JDatePanelImpl;
import org.jdatepicker.impl.JDatePickerImpl;
import org.jdatepicker.impl.UtilDateModel;

public class InvoiceApp {
    //UI Creation
    TopPanel myTopPanel;
    BottomPanel myBottomPanel;
    private InvoiceDialogs dialogs;
    private JFrame frame;
    private JTable table;
    private DefaultTableModel tableModel;
    private TableRowSorter<DefaultTableModel> sorter;
    private InvoiceManager manager;
    private JLabel totalPaidLabel, totalUnpaidLabel;

    private JLabel titleLabel;
    private JLabel logoLabel;
    private ImageIcon originalLogo; 

    private int currentFontSize = 14; 
    //calling methods inside constructor to avoid static error
    public InvoiceApp() {
        manager = new InvoiceManager();
        dialogs = new InvoiceDialogs(this); // Pass mainApp reference
        initializeUI();
        refreshTableData();
        applyZoom(); 
    }
    
        public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new InvoiceApp());
    }
    //adding GUI function & making UI look clean
    private void initializeUI() {
        //Calling Top Panel
        frame = new JFrame("JNG Resources - Invoice Tracker v2.9");
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setSize(1250, 600); 
        frame.setLayout(new BorderLayout(10, 10));
        myTopPanel = new TopPanel();
        frame.add(myTopPanel, BorderLayout.NORTH);

        // Table setup
        String[] columns = {"Date", "Invoice ID", "Job No", "Customer", "Description", "Total (RM)", "Paid (RM)", "Balance (RM)", "Status", "Paid Date", "Remark"};
        tableModel = new DefaultTableModel(columns, 0) {
            @Override
            public boolean isCellEditable(int row, int column) { return false; }
        };

        table = new JTable(tableModel);
        sorter = new TableRowSorter<>(tableModel);
        table.setRowSorter(sorter);
        setupTableColors();

        JScrollPane scrollPane = new JScrollPane(table);
        frame.add(scrollPane, BorderLayout.CENTER);

        myBottomPanel = new BottomPanel();
        frame.add(myBottomPanel, BorderLayout.SOUTH);

        //Zoom Functionality
        myBottomPanel.getBtnZoomIn().addActionListener(e -> { 
                    if (currentFontSize < 28) { 
                        currentFontSize += 2; applyZoom();
                    } 
            });

        myBottomPanel.getBtnZoomOut().addActionListener(e -> { 
                    if (currentFontSize > 10) { 
                        currentFontSize -= 2; applyZoom();
                    } 
            });

        myTopPanel.getButtonPanel().getBtnAdd().addActionListener(e -> dialogs.showAddInvoiceDialog());
        myTopPanel.getButtonPanel().getBtnEdit().addActionListener(e -> dialogs.showEditInvoiceDialog());
        myTopPanel.getButtonPanel().getBtnPayment().addActionListener(e -> dialogs.showPaymentDialog());

        myTopPanel.getSearchField().addKeyListener(new KeyAdapter() {
                @Override
                public void keyReleased(KeyEvent e) {
                    String text = myTopPanel.getSearchField().getText();
                    if (text.trim().length() == 0) sorter.setRowFilter(null);
                    else sorter.setRowFilter(RowFilter.regexFilter("(?i)" + text));
                }
            });

        myTopPanel.getFilterBox().addActionListener(e -> {
                    if (myTopPanel.getFilterBox().getSelectedIndex() == 0) sorter.setRowFilter(null);
                    else sorter.setRowFilter(RowFilter.regexFilter((String) myTopPanel.getFilterBox().getSelectedItem()));
            });

        frame.setVisible(true);
    }

    public void refreshTableData() {
        tableModel.setRowCount(0); 
        double totalCollected = 0, totalOutstanding = 0;

        for (Invoice inv : manager.getAllInvoices()) {
            double balance = inv.getAmount() - inv.getAmountPaid();

            Object[] row = {
                    inv.getDate(), inv.getInvoiceId(), inv.getJobNo(), 
                    inv.getCustomerName(), inv.getDescription(), 
                    String.format("%.2f", inv.getAmount()),        
                    String.format("%.2f", inv.getAmountPaid()),    
                    String.format("%.2f", balance),                
                    inv.getStatus(), inv.getPaidDate(), inv.getRemark()
                };
            tableModel.addRow(row);
            totalCollected += inv.getAmountPaid();
            totalOutstanding += balance;
        }

        myBottomPanel.getTotalPaidLabel().setText(String.format("Total Collected: RM %.2f  |  ", totalCollected));
        myBottomPanel.getTotalUnpaidLabel().setText(String.format("Total Outstanding: RM %.2f", totalOutstanding));
    }

    private void setupTableColors() {
        table.getColumnModel().getColumn(8).setCellRenderer(new javax.swing.table.DefaultTableCellRenderer() {
                @Override
                public Component getTableCellRendererComponent(JTable table, Object value, boolean isSelected, boolean hasFocus, int row, int column) {
                    Component c = super.getTableCellRendererComponent(table, value, isSelected, hasFocus, row, column);
                    if ("Paid".equals(value)) {
                        c.setForeground(new Color(0, 150, 0)); 
                        c.setFont(c.getFont().deriveFont(Font.BOLD));
                    } else if ("Partial".equals(value)) {
                        c.setForeground(new Color(255, 120, 0)); 
                        c.setFont(c.getFont().deriveFont(Font.BOLD));
                    } else if ("Unpaid".equals(value)) {
                        c.setForeground(Color.RED); 
                        c.setFont(c.getFont().deriveFont(Font.BOLD));
                    } else {
                        c.setForeground(Color.BLACK); 
                        c.setFont(table.getFont());
                    }
                    if (isSelected) c.setForeground(table.getSelectionForeground());
                    return c;
                }
            });
    }

    private void applyZoom() {
        updateComponentFont(frame, currentFontSize);
        table.setRowHeight(currentFontSize + 10);
        table.getTableHeader().setFont(new Font("SansSerif", Font.BOLD, currentFontSize));

        // 1. Scale the INVOICE title dynamically (Makes it 3x bigger than normal text!)
        if (titleLabel != null) {
            titleLabel.setFont(new Font("SansSerif", Font.BOLD, currentFontSize * 2)); 
        }

        // 2. Scale the Logo Image dynamically (Now supports 150x50 Rectangles!)
        if (logoLabel != null && originalLogo != null) {

            // Calculate how much we have zoomed in compared to the default size (14)
            double scaleFactor = (double) currentFontSize / 14.0; 

            // Apply that zoom multiplier to your specific 150x50 dimensions
            int currentWidth = (int) (150 * scaleFactor);
            int currentHeight = (int) (50 * scaleFactor);

            Image scaledImage = originalLogo.getImage().getScaledInstance(currentWidth, currentHeight, Image.SCALE_SMOOTH);
            logoLabel.setIcon(new ImageIcon(scaledImage));
        }

        frame.revalidate();
        frame.repaint();
    }

    private void updateComponentFont(Component comp, int newSize) {

        if (comp == titleLabel || comp == logoLabel) {
            return; 
        }

        Font currentFont = comp.getFont();
        if (currentFont != null) {
            comp.setFont(new Font(currentFont.getName(), currentFont.getStyle(), newSize));
        }
        if (comp instanceof Container) {
            for (Component child : ((Container) comp).getComponents()) {
                updateComponentFont(child, newSize); 
            }
        }
    }

    public JFrame getFrame() { 
        return frame;
    }

    public InvoiceManager getManager() { 
        return manager;
    }

    public int getCurrentFontSize() { 
        return currentFontSize; 
    }
    
    public JTable getTable() { 
        return table;
    }

}

